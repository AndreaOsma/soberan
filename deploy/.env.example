# Self-hosted Compose (.env)

# Host port published by Compose
SOBERAN_HTTP_PORT=8080

# Optional: token for iCal feed (?token=)
SOBERAN_API_KEY=

# Optional image override (default: soberan:local from build)
# SOBERAN_IMAGE=andreaosma/soberan:latest

LOG_LEVEL=INFO
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080

# Dedicated sync server (see deploy/sync-server.env.example, deploy/systemd/, deploy/nginx.sync-server.conf)
# SOBERAN_SYNC_SERVER_MODE=1
# SOBERAN_SYNC_SERVER_TOKEN=
# SOBERAN_SYNC_SERVER_STORAGE_DIR=./data/sync-server
