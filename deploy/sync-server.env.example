# Copy to /etc/soberan/sync-server.env (or path in systemd unit) and chmod 600.
# Generate token: openssl rand -hex 32

SOBERAN_SYNC_SERVER_TOKEN=change-me
SOBERAN_SYNC_HOST=127.0.0.1
SOBERAN_SYNC_PORT=8787
SOBERAN_SYNC_SERVER_STORAGE_DIR=/var/lib/soberan/sync-server
DATABASE_URL=sqlite:////var/lib/soberan/sync-server/soberan-sync-meta.db
