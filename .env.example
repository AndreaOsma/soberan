# Token opcional para el feed iCal (?token=). Vacío = feed sin token.
# Self-host: protege la app con tu reverse proxy / SSO si hace falta (no hay login en el frontend).
SOBERAN_API_KEY=

# GoCardless Bank Account Data API (anteriormente Nordigen)
# Obtén tus credenciales en: https://bankaccountdata.gocardless.com/overview/
GOCARDLESS_SECRET_ID=
GOCARDLESS_SECRET_KEY=

# --- Docker Compose (deploy/) — ver deploy/.env.example ---
# SOBERAN_HTTP_PORT=8080
# Por defecto la imagen all-in-one usa SQLite en /data/soberan.db
# DATABASE_URL=sqlite:////data/soberan.db

# --- Documentación / uso avanzado ---
SECRET_KEY=your_random_secret_key_here

ENABLE_ENCRYPTION=true
ENCRYPTION_KEY=your_32_character_encryption_key
LOG_LEVEL=INFO

DEBUG_MODE=false
ALLOWED_HOSTS=localhost,127.0.0.1
PORT=8080
CORS_ALLOW_ORIGINS=http://localhost:8080,http://127.0.0.1:8080,http://localhost:5173,http://127.0.0.1:5173

# Backups (intención; automatiza en tu stack si lo necesitas — ver docs/operations.md)
BACKUP_ENABLED=true
BACKUP_FREQUENCY=daily
BACKUP_RETENTION_DAYS=30

# Chat / Ollama (opcional). También configurable en Ajustes → Asistente.
# Prioridad URL: ajuste en BD → OLLAMA_BASE_URL → http://127.0.0.1:11434
OLLAMA_BASE_URL=
OLLAMA_MODEL=

# Override URL de comprobación de updates desktop (default: GitHub Releases desktop-latest)
# SOBERAN_RELEASES_URL=https://api.github.com/repos/AndreaOsma/soberan/releases/tags/desktop-latest

# Native sync (Windows/APK) - opt-in
# Enable sync routes outside desktop mode (e.g. backend used by APK):
# SOBERAN_NATIVE_SYNC=1
# Google Drive OAuth (required for "Conectar Google Drive"):
# SOBERAN_GOOGLE_CLIENT_ID=
# SOBERAN_GOOGLE_CLIENT_SECRET=

# Dedicated sync server mode (optional, separate deployment):
# SOBERAN_SYNC_SERVER_MODE=1
# SOBERAN_SYNC_SERVER_TOKEN=change-me
# SOBERAN_SYNC_SERVER_STORAGE_DIR=./data/sync-server

# Valoración de vehículos (Activos fijos → Valorar)
# Solo APIs públicas (Autoscout24 + Wallapop + coches.net). Haircut asking→venta (0.08–0.18).
VEHICLE_ASK_HAIRCUT=0.12
